# Per provare in locale: copia in .env. Su Vercel questi valori vanno nelle Environment Variables.
# Locale: database SQLite. Su Vercel: DATABASE_URL arriva dall'integrazione Neon.
DATABASE_URL=sqlite:///./nexus.db
# Stringa casuale lunga (almeno 32 caratteri) per firmare le sessioni. Mai nel codice.
SESSION_SECRET=
# Codice di prima configurazione (almeno 16 caratteri casuali). Serve solo a creare la password.
SETUP_CODE=
TICKTICK_TOKEN=
TICKTICK_TIMEZONE=Europe/Rome
